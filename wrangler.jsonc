{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "letterboxd-widget",
	"main": "src/index.js",
	"compatibility_date": "2026-09-26",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"cache": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "WIDGET_KV",
			"id": "76e4d2169a204eccb25726f3c9108732"
		}
	],
	"ratelimits": [
  		{ 
			"name": "RATE_LIMITER", 
			"namespace_id": "1001", 
			"simple": { 
				"limit": 100, 
				"period": 60 
				} 
			}
	],
}